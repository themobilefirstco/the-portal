{
  "name": "the-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Local macOS Google Meet room controller for a Mac mini kiosk, with calendar invites, drop-in meetings, and an office dashboard between calls.",
  "keywords": [
    "google-meet",
    "mac-mini",
    "kiosk",
    "calendar",
    "drop-in",
    "office-portal",
    "video-conferencing"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs --unit",
    "check": "node scripts/check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "apply-config": "node scripts/apply-config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/themobilefirstco/the-portal.git"
  }
}
